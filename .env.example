# Griffin environment (names only; copy to .env for LOCAL development and fill in values).
# The Go server does NOT load .env itself: `make run` sources it. Secrets have NO defaults.
# Unset ENVIRONMENT is treated as production (fail closed).

ENVIRONMENT=development            # production | development | test
PORT=8080
LOG_LEVEL=info
GRIFFIN_MODE=all                   # api | worker | all

# Database. Supabase: session pooler :5432 for the worker and migrations,
# transaction pooler :6543 for Lambda (the server auto-switches pgx to the simple protocol).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/griffin_dev?sslmode=disable
# MIGRATION_DATABASE_URL=            # optional override for griffin-migrate (never port 6543)
DB_MAX_CONNS=25                    # use 2 on Lambda
DB_MIN_CONNS=2                     # use 0 on Lambda

# Authentication (required, no defaults). Production rejects placeholders and <32 chars.
SUPABASE_JWT_SECRET=               # legacy HS256 secret, or leave empty and set SUPABASE_JWKS_URL
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
WORKER_API_KEY=                    # >=32 random chars; also used by the scheduler tick
ENABLE_DEV_LOGIN=false             # DEVELOPMENT ONLY; startup fails if true in production
CORS_ALLOWED_ORIGINS=http://localhost:3000   # comma-separated exact origins, no wildcards

# Task engine
LEASE_DURATION_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=15
REAPER_INTERVAL_SECONDS=30
MAX_CONCURRENT_WORKERS=2

# AI provider (production worker must be antigravity; no unattended-auth env is invented here)
AI_PROVIDER=mock                   # antigravity | mock (mock is rejected in production workers)
ANTIGRAVITY_BINARY=agy
MAX_CONCURRENT_ANTIGRAVITY=1
EXECUTION_TIMEOUT_SECONDS=300
WORKSPACE_ROOT=/tmp/griffin-workspaces

# Scale to zero
SCALE_TO_ZERO_ENABLED=true
IDLE_SHUTDOWN_SECONDS=300
RUNNER_WAKEUP_COOLDOWN_SECONDS=30
EC2_INSTANCE_ID=                   # required in production API mode
AWS_REGION=ap-south-1

# Object storage
STORAGE_PROVIDER=mock              # s3 in production (explicit S3_BUCKET required)
S3_BUCKET=
S3_REGION=ap-south-1
S3_PRESIGN_EXPIRY_MINUTES=15
MAX_UPLOAD_BYTES=5242880
# S3_ENDPOINT / AWS_PROFILE are for local development only and rejected in production.

# Web (build time): NEXT_PUBLIC_API_URL, NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
# NEXT_PUBLIC_ENABLE_DEV_LOGIN (omit in production).

# Operator allow-list (required in production API mode). Comma-separated emails of the Supabase user(s) allowed to use the API.
# Protects the deployment even if Supabase sign-ups are open.
ALLOWED_USER_EMAILS=
# Optional: also pin the operator to Supabase user UUID(s) (JWT sub; Supabase dashboard > Authentication > Users > User UID).
# Comma-separated; invalid UUIDs fail startup. Empty = email claim only (a startup WARN is logged).
ALLOWED_USER_IDS=

# Host API for laptop/phone hosts (ADR-077). Apply migration 000005 first. Off by default.
HOSTS_ENABLED=false
