# Griffin Environment Configuration Example
# Copy to .env and adjust values for your local environment

# Server
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info

# Database (Supabase PostgreSQL / Local PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:54322/griffin_dev?sslmode=disable

# Authentication
# Supabase JWT Secret (found in Supabase Dashboard -> Project Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=griffin-dev-secret-key-do-not-use-in-prod-minimum32chars

# Worker Authentication (Secret key for background workers / cloud runner)
WORKER_API_KEY=griffin-worker-secret-key-dev

# Task Engine & Distributed Leases
LEASE_DURATION_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=15
REAPER_INTERVAL_SECONDS=30
MAX_CONCURRENT_WORKERS=2

# AWS S3 Object Storage (Phase 4)
# Provider: "s3" (production/staging default) or "mock" (in-memory for isolated local testing)
STORAGE_PROVIDER=s3
S3_BUCKET=griffin-artifacts
S3_REGION=ap-south-1
# S3_ENDPOINT=http://localhost:4566 # Optional custom endpoint for LocalStack/MinIO
# S3_FORCE_PATH_STYLE=false
# AWS_PROFILE=griffin-dev # Dedicated AWS CLI profile for local development; omitted on EC2 (uses GriffinEC2WorkerRole instance profile)
S3_PRESIGN_EXPIRY_MINUTES=15
