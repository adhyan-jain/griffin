{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ArtifactObjectsIncludingCompensatingDelete",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::griffin-artifacts-220115213279-ap-south-1/*"
    },
    {
      "Sid": "ArtifactBucketMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::griffin-artifacts-220115213279-ap-south-1"
    },
    {
      "Sid": "FetchWorkerEnv",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParametersByPath",
        "ssm:GetParameter"
      ],
      "Resource": [
        "arn:aws:ssm:ap-south-1:220115213279:parameter/griffin/prod/worker",
        "arn:aws:ssm:ap-south-1:220115213279:parameter/griffin/prod/worker/*"
      ]
    }
  ]
}
