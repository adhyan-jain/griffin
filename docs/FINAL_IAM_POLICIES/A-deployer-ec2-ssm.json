{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Describe",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeImages",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeVolumes",
        "ec2:DescribeTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "RunInstancesSupportingResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:ap-south-1::image/*",
        "arn:aws:ec2:ap-south-1:123456789012:subnet/*",
        "arn:aws:ec2:ap-south-1:123456789012:network-interface/*",
        "arn:aws:ec2:ap-south-1:123456789012:security-group/*"
      ]
    },
    {
      "Sid": "RunInstancesT4gMediumImdsv2Tagged",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ap-south-1:123456789012:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:InstanceType": "t4g.medium",
          "ec2:MetadataHttpTokens": "required",
          "aws:RequestTag/Project": "Griffin"
        }
      }
    },
    {
      "Sid": "RunInstancesEncryptedVolumeMax30",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ap-south-1:123456789012:volume/*",
      "Condition": {
        "Bool": {
          "ec2:Encrypted": "true"
        },
        "NumericLessThanEquals": {
          "ec2:VolumeSize": "30"
        }
      }
    },
    {
      "Sid": "TagOnCreateOnly",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:ap-south-1:123456789012:instance/*",
        "arn:aws:ec2:ap-south-1:123456789012:volume/*",
        "arn:aws:ec2:ap-south-1:123456789012:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateSecurityGroup"
          ]
        }
      }
    },
    {
      "Sid": "CreateRunnerSecurityGroupInDefaultVpc",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": [
        "arn:aws:ec2:ap-south-1:123456789012:vpc/vpc-0c233c7991952ec37",
        "arn:aws:ec2:ap-south-1:123456789012:security-group/*"
      ]
    },
    {
      "Sid": "ReadExistingWorkerRoleAndProfile",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/GriffinEC2WorkerRole",
        "arn:aws:iam::123456789012:instance-profile/GriffinEC2WorkerProfile"
      ]
    },
    {
      "Sid": "PassExistingWorkerRoleToEc2Only",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::123456789012:role/GriffinEC2WorkerRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ResolveUbuntuAmi",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:ap-south-1::parameter/aws/service/canonical/ubuntu/server/24.04/stable/current/arm64/hvm/ebs-gp3/ami-id"
    },
    {
      "Sid": "RunnerPowerControlForAcceptanceTests",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances"
      ],
      "Resource": "arn:aws:ec2:ap-south-1:123456789012:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "Griffin"
        }
      }
    },
    {
      "Sid": "SessionManagerToRunner",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": [
        "arn:aws:ec2:ap-south-1:123456789012:instance/*",
        "arn:aws:ssm:ap-south-1:123456789012:document/SSM-SessionManagerRunShell"
      ],
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Project": "Griffin"
        }
      }
    },
    {
      "Sid": "RunCommandOnRunner",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:ap-south-1:123456789012:instance/*",
        "arn:aws:ssm:ap-south-1::document/AWS-RunShellScript"
      ],
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Project": "Griffin"
        }
      }
    },
    {
      "Sid": "SsmReadOnlyHousekeeping",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeInstanceInformation",
        "ssm:DescribeSessions",
        "ssm:GetConnectionStatus",
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EndOwnSessions",
      "Effect": "Allow",
      "Action": [
        "ssm:TerminateSession",
        "ssm:ResumeSession"
      ],
      "Resource": "arn:aws:ssm:*:*:session/${aws:userid}-*"
    },
    {
      "Sid": "ReleaseBundleUpload",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::griffin-artifacts-123456789012-ap-south-1/releases/*"
    }
  ]
}
