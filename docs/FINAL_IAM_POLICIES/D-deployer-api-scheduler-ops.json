{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LambdaApi",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:PublishVersion",
        "lambda:CreateAlias",
        "lambda:UpdateAlias",
        "lambda:AddPermission",
        "lambda:TagResource",
        "lambda:PutFunctionConcurrency",
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:lambda:ap-south-1:220115213279:function:griffin-api",
        "arn:aws:lambda:ap-south-1:220115213279:function:griffin-api:*"
      ]
    },
    {
      "Sid": "ReadAdapterLayer",
      "Effect": "Allow",
      "Action": "lambda:GetLayerVersion",
      "Resource": "arn:aws:lambda:ap-south-1:753240598075:layer:LambdaAdapterLayerArm64:*"
    },
    {
      "Sid": "CreateOnlyTheTwoNewRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:PutRolePolicy",
        "iam:TagRole"
      ],
      "Resource": [
        "arn:aws:iam::220115213279:role/griffin-api-lambda-role",
        "arn:aws:iam::220115213279:role/griffin-events-invoke-role"
      ]
    },
    {
      "Sid": "AttachBasicLogsOnly",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::220115213279:role/griffin-api-lambda-role",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        }
      }
    },
    {
      "Sid": "PassOnlyThoseRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::220115213279:role/griffin-api-lambda-role",
        "arn:aws:iam::220115213279:role/griffin-events-invoke-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "events.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DescribeLogGroups",
        "logs:FilterLogEvents",
        "logs:GetLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-south-1:220115213279:log-group:/aws/lambda/griffin-api*"
    },
    {
      "Sid": "Secrets",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter",
        "ssm:GetParametersByPath"
      ],
      "Resource": "arn:aws:ssm:ap-south-1:220115213279:parameter/griffin/prod/*"
    },
    {
      "Sid": "ListParamsNotResourceScopable",
      "Effect": "Allow",
      "Action": "ssm:DescribeParameters",
      "Resource": "*"
    },
    {
      "Sid": "EventBridgeTick",
      "Effect": "Allow",
      "Action": [
        "events:PutRule",
        "events:DescribeRule",
        "events:EnableRule",
        "events:DisableRule",
        "events:PutTargets",
        "events:RemoveTargets",
        "events:DeleteRule",
        "events:CreateConnection",
        "events:DescribeConnection",
        "events:UpdateConnection",
        "events:CreateApiDestination",
        "events:DescribeApiDestination",
        "events:UpdateApiDestination"
      ],
      "Resource": [
        "arn:aws:events:ap-south-1:220115213279:rule/griffin-*",
        "arn:aws:events:ap-south-1:220115213279:connection/griffin-*",
        "arn:aws:events:ap-south-1:220115213279:api-destination/griffin-*"
      ]
    },
    {
      "Sid": "EventBridgeConnectionSecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue",
        "secretsmanager:UpdateSecret"
      ],
      "Resource": "arn:aws:secretsmanager:ap-south-1:220115213279:secret:events!connection/griffin-*"
    },
    {
      "Sid": "HttpApiNotFinerScopable",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Resource": [
        "arn:aws:apigateway:ap-south-1::/apis",
        "arn:aws:apigateway:ap-south-1::/apis/*",
        "arn:aws:apigateway:ap-south-1::/tags/*"
      ]
    },
    {
      "Sid": "S3Lifecycle",
      "Effect": "Allow",
      "Action": [
        "s3:GetLifecycleConfiguration",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": "arn:aws:s3:::griffin-artifacts-220115213279-ap-south-1"
    },
    {
      "Sid": "Budgets",
      "Effect": "Allow",
      "Action": [
        "budgets:ViewBudget",
        "budgets:ModifyBudget"
      ],
      "Resource": "arn:aws:budgets::220115213279:budget/griffin-*"
    },
    {
      "Sid": "AlertsTopicAndAlarms",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:Subscribe",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:DeleteAlarms"
      ],
      "Resource": [
        "arn:aws:sns:ap-south-1:220115213279:griffin-alerts",
        "arn:aws:cloudwatch:ap-south-1:220115213279:alarm:griffin-*"
      ]
    },
    {
      "Sid": "CostVisibilityNotResourceScopable",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "*"
    }
  ]
}
