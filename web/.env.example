# Copy to web/.env.local. Everything here is public (it ships to the browser): never put a secret key in it.

# Where the Griffin API runs (see ../.env.example to run it locally).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Your Supabase project, for sign-in. The anon key is designed to be public.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "true" shows a no-password dev login. Local development only; the server must set ENABLE_DEV_LOGIN too.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false
